# CLOUD-ONLY Ratneswar ERP V8
# Copy these values into Netlify Environment Variables. Do not commit real secrets.

# Supabase Auth / Postgres / Storage
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# Cloudflare Workers AI — runs in cloud, not office PC
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_AI_API_TOKEN=YOUR_WORKERS_AI_TOKEN
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Keep this aligned with the final production origin (no trailing slash).
NEXT_PUBLIC_APP_URL=https://YOUR-SITE.netlify.app
NEXT_PUBLIC_APP_NAME="Ratneswar Engineering ERP"
