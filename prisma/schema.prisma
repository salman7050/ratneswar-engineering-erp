// ── Saved combined signature + stamp assets ─────────────────

model SignatureAsset {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations     Quotation[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]

  @@map("signature_assets")
}

// ── Legacy AI job table retained for backward-compatible migrations ──

enum AiJobStatus {
  QUEUED
  PROCESSING
  MODEL_DONE
  DONE
  FAILED
}

model AiJob {
  id            String      @id @default(cuid())
  status        AiJobStatus @default(QUEUED)
  request       Json
  rawResponse   String?
  finalResponse Json?
  error         String?
  model         String?
  pickedAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("ai_jobs")
}

// ── Automatic document numbering ──────────────────────────────

enum DocumentKind {
  QUOTATION
  INVOICE
  PURCHASE_ORDER
  WORK_ORDER
}

model DocumentSequence {
  id            String       @id @default(cuid())
  kind          DocumentKind
  financialYear String
  nextValue     Int          @default(1)
  updatedAt     DateTime     @updatedAt

  @@unique([kind, financialYear])
  @@map("document_sequences")
}

// ── Audit Trail ───────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. "TENDER_CREATED", "INVOICE_GENERATED"
  entityType String // e.g. "Tender", "Invoice"
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ── Inventory: Vendors, Stores, Stock ────────────────────────

model Vendor {
  id            String   @id @default(cuid())
  name          String
  code          String?  @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstin         String?
  pan           String?
  createdAt     DateTime @default(now())

  transactions   StockTransaction[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@map("vendors")
}

enum StoreType {
  CENTRAL
  SITE
}

model Store {
  id        String    @id @default(cuid())
  name      String
  type      StoreType @default(CENTRAL)
  createdAt DateTime  @default(now())

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  transactions StockTransaction[]

  @@map("stores")
}

model StockItem {
  id           String   @id @default(cuid())
  name         String
  sku          String   @unique // encoded into the item's QR/barcode label
  category     String
  unit         String
  reorderLevel Decimal  @default(0) @db.Decimal(12, 2)
  standardRate Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  transactions StockTransaction[]

  @@map("stock_items")
}

enum StockTxnType {
  RECEIVE
  ISSUE
}

model StockTransaction {
  id          String       @id @default(cuid())
  type        StockTxnType
  quantity    Decimal      @db.Decimal(12, 2)
  rate        Decimal?     @db.Decimal(10, 2)
  date        DateTime
  referenceNo String?
  issuedTo    String? // person/site the material was issued to
  notes       String?
  createdAt   DateTime     @default(now())

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  createdById String
  createdBy   User   @relation("StockTxnCreator", fields: [createdById], references: [id])

  @@map("stock_transactions")
}

// ═══════════════════════════════════════════════════════════════
// Daily Command Center — every employee's daily brain
// ═══════════════════════════════════════════════════════════════

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskCategory {
  SITE_VISIT
  INVOICE
  QUOTATION
  TENDER
  FOLLOW_UP
  MATERIAL_ORDER
  MEETING
  DOCUMENTATION
  MAINTENANCE
  ADMIN
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  category    TaskCategory @default(OTHER)
  status      TaskStatus   @default(PENDING)
  progress    Int          @default(0) // 0-100
  dueDate     DateTime? // date-only, time stripped to midnight
  dueTime     String? // "14:30" — kept as a string, display-only
  reminderAt  DateTime?
  attachmentUrl String?
  notes       String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  assignedToId String
  assignedTo   User   @relation("TaskAssignee", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  comments TaskComment[]

  @@index([assignedToId, status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

enum FollowUpType {
  CALL_VENDOR
  CALL_CLIENT
  PAYMENT_REMINDER
  QUOTATION_REMINDER
  TRANSFORMER_TESTING
  INSPECTION
  OTHER
}

enum FollowUpStatus {
  PENDING
  DONE
}

model FollowUp {
  id        String         @id @default(cuid())
  title     String
  type      FollowUpType   @default(OTHER)
  dueDate   DateTime
  notes     String?
  status    FollowUpStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  assignedToId String
  assignedTo   User   @relation("FollowUpAssignee", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("FollowUpCreator", fields: [createdById], references: [id])

  @@index([assignedToId, status, dueDate])
  @@map("follow_ups")
}

model QuickNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("quick_notes")
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id         String        @id @default(cuid())
  date       DateTime // date-only
  time       String // "10:30"
  withPerson String
  purpose    String
  status     MeetingStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([createdById, date])
  @@map("meetings")
}

enum SiteVisitStatus {
  PLANNED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model SiteVisit {
  id        String          @id @default(cuid())
  date      DateTime // date-only
  time      String // "09:00"
  purpose   String
  status    SiteVisitStatus @default(PLANNED)
  checkInAt  DateTime?
  checkOutAt DateTime?
  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  engineerId String
  engineer   User   @relation(fields: [engineerId], references: [id])

  @@index([engineerId, date])
  @@map("site_visits")
}

enum ReminderType {
  AMC_EXPIRY
  INSURANCE_EXPIRY
  TENDER_SUBMISSION
  INVOICE_DUE
  SALARY_DATE
  PF_DUE
  GST_RETURN
  SITE_VISIT
  MAINTENANCE
  CALIBRATION
  VEHICLE_SERVICE
  OTHER
}

enum ReminderStatus {
  ACTIVE
  DONE
  DISMISSED
}

enum RecurrenceType {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

model SmartReminder {
  id         String         @id @default(cuid())
  type       ReminderType   @default(OTHER)
  title      String
  notes      String?
  dueDate    DateTime
  recurrence RecurrenceType @default(NONE)
  status     ReminderStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([status, dueDate])
  @@map("smart_reminders")
}

model EndOfDayReport {
  id            String   @id @default(cuid())
  date          DateTime // date-only
  completedWork String
  pendingWork   String?
  tomorrowPlan  String?
  createdAt     DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("eod_reports")
}
